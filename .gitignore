# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Virtual environments (recreate with docs/01-setup-*.md) --------------
.venv/
venv/
env/

# --- Data and runs: never commit volumes, weights or run outputs ----------
# Raw and processed images can be hundreds of megabytes; they are downloaded
# or generated by scripts in the repo, so the repo stays small and the data
# stays reproducible. The .gitkeep files preserve the folder layout.
# Git cannot re-include a file whose parent directory is excluded, so the
# directories are re-included first (!data/**/), then the marker files.
data/**
!data/**/
!data/.gitkeep
!data/**/.gitkeep
runs/**
!runs/.gitkeep
models/**
!models/.gitkeep

# --- Secrets ---------------------------------------------------------------
.env
*.key

# --- Editors and operating systems -------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
